# dependencies (restored with `pnpm install`)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js build output
/.next/
/out/

# production build
/build

# local embedded database (PGlite)
/.data

# fast-gate training: Python env, downloaded datasets and build artefacts
# (recreated with `pnpm ml:setup && pnpm ml:all`; the trained model in
# src/data/gate-model.json IS committed)
/ml/.venv
/ml/raw
/ml/build
__pycache__/
*.pyc

# env files: secrets stay local; the template is committed
.env*
!.env.example

# misc
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors
.idea/
*.swp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android app build output and machine-specific SDK path (android/)
/android/.gradle
/android/build
/android/app/build
/android/local.properties
/android/*.keystore
/android/.kotlin
/android/dist
