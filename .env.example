# Copy to .env.local. Everything is optional for local development.

# Claude reads only the messages the rules and the fast-gate model are unsure
# about, and powers "Run on Haiku / Sonnet" on /tests. Without it the app
# answers with rules + model and shows "Checked by rules only".
ANTHROPIC_API_KEY=

# Production Postgres (Neon). Leave empty locally: the app then runs an
# embedded Postgres (PGlite) in .data/. Required on Vercel.
DATABASE_URL=

# The "Call" buttons open the phone's dialer. For a live demo, set the demo
# personas to your teammates' real numbers (any 10-digit Indian mobile number).
# Empty = placeholder numbers, which may belong to strangers: do not dial them.
DEMO_RAO_PHONE=
DEMO_MOM_PHONE=
DEMO_ARJUN_PHONE=
DEMO_MEERA_PHONE=

# Web Push (alerts that reach phones even when the app is closed, in a
# browser or the iPhone home-screen app).
# Generate a pair once with `pnpm push:keys` and keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# FCM (the same alerts for the Android app, docs/push.md). The Firebase
# project's service account key: Firebase console > Project settings > Service
# accounts > Generate new private key. Paste the whole JSON file, as is or
# base64-encoded (`base64 -w0 key.json`). Keep it secret. The app itself needs
# that project's google-services.json at build time.
FCM_SERVICE_ACCOUNT=

# Signs the demo sessions and keys the message fingerprints. Set long random
# values in production (e.g. `openssl rand -base64 32`).
SESSION_SECRET=
FINGERPRINT_SECRET=

# Before a public deploy: every operator page (/demo, /tests, /campaigns,
# /reports) and "Reset demo data" then ask for this key once per browser tab.
# Use a long random value (e.g. `openssl rand -base64 32`). Leave empty on a laptop.
OPERATOR_KEY=

# Demo sign-in ("Continue as Mr Rao", and sign-in codes shown on screen once
# instead of sent by SMS) lets anyone become a demo persona. on / off; empty =
# on for a laptop or CI, off on a deployment (Vercel, Railway, Render, Fly.io,
# Cloud Run, DEPLOYED=1). Set it to "on" only on a protected demo deployment.
DEMO_SIGNIN=

# Who delivers the 4-digit sign-in codes: demo (default; shown on screen while
# DEMO_SIGNIN is on) or sms (not set up yet: asking for a code answers 503).
OTP_PROVIDER=

# Unlocks the scheduled jobs: the hourly purge (POST /api/cron/purge,
# docs/retention.md) and the 30-minute sync (POST /api/cron/sync). Set the same
# value as the CRON_SECRET secret of the GitHub repository, whose Uptime and
# Sync workflows call them. Leave empty on a laptop.
CRON_SECRET=
