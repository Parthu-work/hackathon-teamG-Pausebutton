<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PauseButton" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <!-- Shown for a moment while Chrome opens the web app. -->
    <style name="Theme.PauseButton.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
